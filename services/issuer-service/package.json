{
  "name": "@atlas/issuer-service",
  "version": "0.1.0",
  "private": true,
  "description": "ATLAS Issuer Service",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./service": {
      "@atlas/source": "./src/service.ts",
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=@atlas/source --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@atlas/observability": "workspace:*",
    "@atlas/schemas": "workspace:*",
    "@atlas/service-kit": "workspace:*",
    "@atlas/shared": "workspace:*",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "jose": "^6.2.13"
  }
}

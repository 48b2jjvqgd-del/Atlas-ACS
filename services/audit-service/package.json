{
  "name": "@atlas/audit-service",
  "version": "0.1.0",
  "private": true,
  "description": "ATLAS Audit Service",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./service": {
      "@atlas/source": "./src/service.ts",
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=@atlas/source --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@atlas/service-kit": "workspace:*"
  },
  "files": [
    "dist"
  ]
}

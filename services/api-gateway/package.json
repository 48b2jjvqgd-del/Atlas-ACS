{
  "name": "@atlas/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "ATLAS API Gateway",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./service": {
      "@atlas/source": "./src/service.ts",
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=@atlas/source --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@atlas/observability": "workspace:*",
    "@atlas/schemas": "workspace:*",
    "@atlas/security": "workspace:*",
    "@atlas/service-kit": "workspace:*",
    "@atlas/shared": "workspace:*",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "openid-client": "^6.8.8"
  },
  "files": [
    "dist"
  ]
}

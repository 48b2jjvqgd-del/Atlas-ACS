# ATLAS ACS — local development configuration (placeholders only)
#
# Create your local .env with:   pnpm setup:env
# That copies this file and replaces every __GENERATE__ with a random local-only value.
#
# Never commit .env. Never place real, shared, employer or production credentials here.
# In controlled environments, inject configuration via the platform's secret store, using
# the NAME_FILE convention (e.g. DATABASE_URL_FILE=/run/secrets/database-url).

# ---- Platform -----------------------------------------------------------------------
ATLAS_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# ---- Local infrastructure credentials (docker compose) ------------------------------
POSTGRES_USER=atlas
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=atlas
VALKEY_PASSWORD=__GENERATE__
RABBITMQ_USER=atlas
RABBITMQ_PASSWORD=__GENERATE__
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE__
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__

# ---- Database roles (Stage 1A, ADR-012) ----------------------------------------------
# Every service connects with its own least-privilege role; only the migrator runs DDL, and only
# role provisioning uses the administrative connection. See docs/architecture/DATA_MODEL.md.
# ${VAR} references are expanded by `pnpm setup:env`; edit afterwards if you change a password.
DATABASE_ADMIN_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}
DB_PASSWORD_MIGRATOR=__GENERATE__
MIGRATION_DATABASE_URL=postgres://atlas_migrator:${DB_PASSWORD_MIGRATOR}@127.0.0.1:5432/${POSTGRES_DB}
DB_PASSWORD_ACS_CORE=__GENERATE__
DB_PASSWORD_FRAUD_ENGINE=__GENERATE__
DB_PASSWORD_COMPLIANCE_ENGINE=__GENERATE__
DB_PASSWORD_CHALLENGE_ENGINE=__GENERATE__
DB_PASSWORD_ISSUER_SERVICE=__GENERATE__
DB_PASSWORD_CARDHOLDER_SERVICE=__GENERATE__
DB_PASSWORD_IDENTITY_SERVICE=__GENERATE__
DB_PASSWORD_REPORTING_SERVICE=__GENERATE__
DB_PASSWORD_AUDIT_SERVICE=__GENERATE__
# Host-run services (pnpm dev:services) pick their own URL: <SERVICE>_DATABASE_URL.
ACS_CORE_DATABASE_URL=postgres://atlas_acs_core:${DB_PASSWORD_ACS_CORE}@127.0.0.1:5432/${POSTGRES_DB}
FRAUD_ENGINE_DATABASE_URL=postgres://atlas_fraud_engine:${DB_PASSWORD_FRAUD_ENGINE}@127.0.0.1:5432/${POSTGRES_DB}
COMPLIANCE_ENGINE_DATABASE_URL=postgres://atlas_compliance_engine:${DB_PASSWORD_COMPLIANCE_ENGINE}@127.0.0.1:5432/${POSTGRES_DB}
CHALLENGE_ENGINE_DATABASE_URL=postgres://atlas_challenge_engine:${DB_PASSWORD_CHALLENGE_ENGINE}@127.0.0.1:5432/${POSTGRES_DB}
ISSUER_SERVICE_DATABASE_URL=postgres://atlas_issuer_service:${DB_PASSWORD_ISSUER_SERVICE}@127.0.0.1:5432/${POSTGRES_DB}
CARDHOLDER_SERVICE_DATABASE_URL=postgres://atlas_cardholder_service:${DB_PASSWORD_CARDHOLDER_SERVICE}@127.0.0.1:5432/${POSTGRES_DB}
IDENTITY_SERVICE_DATABASE_URL=postgres://atlas_identity_service:${DB_PASSWORD_IDENTITY_SERVICE}@127.0.0.1:5432/${POSTGRES_DB}
REPORTING_SERVICE_DATABASE_URL=postgres://atlas_reporting_service:${DB_PASSWORD_REPORTING_SERVICE}@127.0.0.1:5432/${POSTGRES_DB}
AUDIT_SERVICE_DATABASE_URL=postgres://atlas_audit_service:${DB_PASSWORD_AUDIT_SERVICE}@127.0.0.1:5432/${POSTGRES_DB}
# Valkey speaks the Redis protocol, so its URL uses the redis:// (or rediss:// for TLS) scheme.
VALKEY_URL=redis://:${VALKEY_PASSWORD}@127.0.0.1:6379/0
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@127.0.0.1:5672

# ---- Identity and sessions (Stage 1A) ------------------------------------------------
# Keycloak realm import substitutes these into atlas-realm.json; services and the gateway use the
# same values. All are generated, local-only and disposable.
OIDC_ISSUER_URL=http://localhost:8180/realms/atlas
KEYCLOAK_CLIENT_SECRET_GATEWAY=__GENERATE__
KEYCLOAK_CLIENT_SECRET_API_GATEWAY=__GENERATE__
KEYCLOAK_CLIENT_SECRET_IDENTITY_SERVICE=__GENERATE__
KEYCLOAK_CLIENT_SECRET_ISSUER_SERVICE=__GENERATE__
KEYCLOAK_CLIENT_SECRET_AUDIT_SERVICE=__GENERATE__
OIDC_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET_GATEWAY}
API_GATEWAY_SERVICE_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET_API_GATEWAY}
IDENTITY_SERVICE_SERVICE_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET_IDENTITY_SERVICE}
ISSUER_SERVICE_SERVICE_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET_ISSUER_SERVICE}
AUDIT_SERVICE_SERVICE_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET_AUDIT_SERVICE}
# 32-byte key encrypting server-side portal sessions in Valkey.
SESSION_ENCRYPTION_KEY=__GENERATE_KEY__
# Where the portal runs: http://localhost:5173 for `pnpm dev:portal`, http://localhost:8080 for
# the container stack (compose sets its own value).
PORTAL_PUBLIC_URL=http://localhost:5173
# Synthetic demo accounts (see docs/DEVELOPMENT.md): one password for every seeded user, and the
# TOTP secret pre-enrolled for platform users. Read them with `pnpm demo:credentials`.
ATLAS_DEMO_PASSWORD=__GENERATE__
ATLAS_DEMO_TOTP_SECRET=__GENERATE__

# ---- Optional -------------------------------------------------------------------------
# Traces to the local Jaeger (docker compose --profile tracing up -d): http://localhost:16686
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

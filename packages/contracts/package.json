{
  "name": "@atlas/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned inter-service API and event contracts.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "@atlas/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "export:json-schema": "tsx --conditions=@atlas/source scripts/export-json-schemas.ts"
  },
  "dependencies": {
    "@atlas/schemas": "workspace:*",
    "@atlas/shared": "workspace:*"
  }
}
